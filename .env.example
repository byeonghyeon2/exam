APP_ENV=development
APP_NAME=CertExam
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=cert_exam
DATABASE_USER=cert_exam_user
DATABASE_PASSWORD=change-me
DATABASE_URL=mysql+pymysql://cert_exam_user:change-me@localhost:3306/cert_exam?charset=utf8mb4
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VERIFICATION_MODEL=
OPENAI_EXPLANATION_MODEL=
