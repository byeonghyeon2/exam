[Unit]
Description=Approved Exam deployment (main only)
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/exam-deploy
TimeoutStartSec=90min
TimeoutStopSec=120s
KillSignal=SIGTERM
UMask=0027
Nice=10
StandardOutput=journal
StandardError=journal
# Deliberately not enabled: deploying requires an explicit operator request.
