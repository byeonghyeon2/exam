APP_ENV=development
APP_NAME=Certification Exam App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
DATABASE_URL=mysql+pymysql://cert_exam_user:change-me@localhost:3306/cert_exam?charset=utf8mb4
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VERIFICATION_MODEL=
OPENAI_EXPLANATION_MODEL=
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=60
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOW_LOCAL_NETWORK=true
PROXY_TRUSTED_IPS=127.0.0.1
AUTH_REQUIRED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-immediately
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul

