APP_ENV=production
APP_NAME=Certification Exam App
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

DATABASE_HOST=database.example.internal
DATABASE_PORT=3306
DATABASE_NAME=cert_exam
DATABASE_USER=cert_exam_user
DATABASE_PASSWORD=replace-with-a-secret

FRONTEND_ORIGIN=http://exam.example.com
CORS_ALLOW_LOCAL_NETWORK=false
PROXY_TRUSTED_IPS=127.0.0.1

AUTH_REQUIRED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-secret
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VERIFICATION_MODEL=
OPENAI_EXPLANATION_MODEL=
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul
